              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Only the total price changed\", function () {",
                  "    pm.expect(body.totalprice).to.eql(250);",
                  "    pm.expect(body.firstname).to.eql(\"Maria\");",
                  "    pm.expect(body.lastname).to.eql(\"Gomez\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
