        {
          "name": "NEG-04 - Update booking without token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Create a temporary booking so this test does not depend on other tests",
                  "pm.sendRequest({",
                  "    url: pm.variables.get(\"baseUrl\") + \"/booking\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\", \"Accept\": \"application/json\" },",
                  "    body: { mode: \"raw\", raw: JSON.stringify({",
                  "        firstname: \"Temp\", lastname: \"User\", totalprice: 100, depositpaid: false,",
                  "        bookingdates: { checkin: \"2026-12-01\", checkout: \"2026-12-02\" }",
                  "    }) }",
                  "}, function (err, res) {",
                  "    pm.collectionVariables.set(\"tempBookingId\", res.json().bookingid);",
                  "});"
                ]
              }
            },
